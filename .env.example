# ── Allgemein (immer erforderlich) ───────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Avatar Provider ───────────────────────────────────────
# Optionen: heygen | anam | tavus
AVATAR_PROVIDER=heygen

# ── Tavus (nur wenn AVATAR_PROVIDER=tavus) ────────────────
TAVUS_API_KEY=your_tavus_api_key_here
TAVUS_REPLICA_ID=your_replica_id_here
TAVUS_PERSONA_ID=                        # optional, leer lassen wenn keine Persona
# Hinweis: Die Custom-LLM-URL (ngrok-URL + /tavus/llm) wird NICHT hier gesetzt,
# sondern im Tavus-Dashboard in der Persona konfiguriert.

# ── HeyGen / LiveAvatar (nur wenn AVATAR_PROVIDER=heygen) ─
LIVEAVATAR_API_KEY=your_liveavatar_api_key_here
LIVEAVATAR_AVATAR_ID=your_avatar_id_here
LIVEAVATAR_VOICE_ID=your_voice_id_here
LIVEAVATAR_CONTEXT_ID=                   # optional
LIVEAVATAR_SANDBOX=true                  # true für Entwicklung, false für Produktion
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_VOICE_ID=your_heygen_voice_id_here
HEYGEN_AVATAR_ID=your_heygen_avatar_id_here

# ── Anam (nur wenn AVATAR_PROVIDER=anam) ─────────────────
ANAM_API_KEY=your_anam_api_key_here
ANAM_PERSONA_ID=your_anam_persona_id_here
